#!/usr/bin/env python3
"""
Camper Van Knowledge Ingestion Pipeline.
Extracts text, structures tables, identifies circuit schematics, 
chunks with semantic boundaries, and uploads to R2, D1, and Vectorize.
"""

import os
import io
import re
import json
import sqlite3
import argparse
from typing import List, Dict, Any
import fitz  # PyMuPDF
import boto3
from openai import OpenAI

# Cloudflare R2 Client (S3 Compatible API)
r2_client = boto3.client(
    "s3",
    endpoint_url=os.environ.get("CF_R2_ENDPOINT"),
    aws_access_key_id=os.environ.get("CF_R2_ACCESS_KEY_ID"),
    aws_secret_access_key=os.environ.get("CF_R2_SECRET_ACCESS_KEY"),
    region_name="auto",
)

R2_BUCKET = os.environ.get("CF_R2_BUCKET_NAME", "campervan-assets")
openai_client = OpenAI(api_key=os.environ.get("OPENAI_API_KEY"))

def extract_and_chunk_pdf(
    pdf_path: str, doc_metadata: Dict[str, Any]
) -> List[Dict[str, Any]]:
    """
    Parses PDF, isolates high-resolution images/schematics, and segments
    clean markdown text chunks with 500-token target size and 100-token overlap.
    """
    doc = fitz.open(pdf_path)
    chunks = []
    
    print(f"[*] Processing: {doc_metadata['title']} ({len(doc)} pages)")
    
    for page_idx in range(len(doc)):
        page = doc[page_idx]
        page_num = page_idx + 1
        text = page.get_text("text")
        
        # 1. Extract embedded schematics / diagrams
        image_list = page.get_images(full=True)
        schematic_id = None
        
        if image_list:
            for img_idx, img in enumerate(image_list):
                xref = img[0]
                base_image = doc.extract_image(xref)
                image_bytes = base_image["image"]
                image_ext = base_image["ext"]
                
                # Filter out tiny logos/icons (under 10KB or < 300px dimensions)
                if len(image_bytes) > 15000 and base_image.get("width", 0) > 300:
                    schematic_id = f"{doc_metadata['id']}_p{page_num}_img{img_idx}"
                    r2_key = f"schematics/{doc_metadata['id']}/{schematic_id}.{image_ext}"
                    
                    r2_client.put_object(
                        Bucket=R2_BUCKET,
                        Key=r2_key,
                        Body=image_bytes,
                        ContentType=f"image/{image_ext}"
                    )
                    break # Link primary diagram on this page

        # 2. Skip pages with virtually no text (pure covers/blanks)
        cleaned_text = re.sub(r'\s+', ' ', text).strip()
        if len(cleaned_text) < 80:
            continue

        # 3. Text segmentation (500 words with 100-word overlap)
        words = cleaned_text.split()
        chunk_size = 500
        overlap = 100
        step = chunk_size - overlap
        
        for i in range(0, max(1, len(words)), step):
            chunk_slice = words[i:i + chunk_size]
            if not chunk_slice:
                continue
            chunk_text = " ".join(chunk_slice)
            
            chunk_id = f"{doc_metadata['id']}_p{page_num}_c{i // step}"
            chunks.append({
                "id": chunk_id,
                "document_id": doc_metadata["id"],
                "page_number": page_num,
                "subsystem": doc_metadata["subsystem"],
                "chunk_text": chunk_text,
                "word_count": len(chunk_slice),
                "token_count": int(len(chunk_slice) * 1.3),
                "schematic_image_id": schematic_id,
            })
            
    return chunks

def generate_embeddings_batch(chunks: List[Dict[str, Any]]) -> List[List[float]]:
    """Batch computes 768-dim embeddings using OpenAI text-embedding-3-small (dimensions=768)"""
    texts = [c["chunk_text"] for c in chunks]
    batch_size = 100
    all_embeddings = []
    
    for i in range(0, len(texts), batch_size):
        batch = texts[i:i + batch_size]
        response = openai_client.embeddings.create(
            model="text-embedding-3-small",
            input=batch,
            dimensions=768
        )
        all_embeddings.extend([item.embedding for item in response.data])
        
    return all_embeddings

5. Deterministic Engineering Core (ABYC Standards)
LLMs must not compute electrical cable gauges or fuse sizing from memory. The server executes these computations deterministically via the following engine adhering to ABYC E-11 (AC and DC Electrical Systems on Boats / RVs):
Where:
 * K = 10.75 (specific resistance of tinned copper at 75°C).
 * I = \text{Current (Amperes continuous)}.
 * L = \text{Total Circuit Length in Feet (\textbf{Round Trip: Positive Run + Negative Return})}.
 * V_{\text{drop}} = \text{System Voltage} \times \text{Acceptable Drop Fraction (0.03 for critical 3\%, 0.10 for non-critical 10\%)}.
Wire Calculation Module (src/mcp/tools/wire_calc.ts)
export interface WireCalculationParams {
  system_voltage: 12 | 24 | 48;
  amperage: number;
  one_way_distance_feet: number;
  allowable_drop_percent: 3 | 10;
  is_engine_compartment: boolean;
}

export interface WireCalculationResult {
  recommended_awg: string;
  exact_voltage_drop_volts: number;
  exact_voltage_drop_percent: number;
  recommended_fuse_amps: number;
  fuse_type: string;
  notes: string[];
}

interface AWGSpec {
  awg: string;
  circular_mils: number;
  resistance_per_1000ft_ohms: number;
  ampacity_outside_engine_105c: number;
  ampacity_inside_engine_105c: number;
}

const AWG_TABLE: AWGSpec[] = [
  { awg: "16", circular_mils: 2580, resistance_per_1000ft_ohms: 4.016, ampacity_outside_engine_105c: 25, ampacity_inside_engine_105c: 21 },
