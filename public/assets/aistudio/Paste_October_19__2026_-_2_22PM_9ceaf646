  { awg: "10", circular_mils: 10380, resistance_per_1000ft_ohms: 0.999, ampacity_outside_engine_105c: 60, ampacity_inside_engine_105c: 51 },
  { awg: "8",  circular_mils: 16510, resistance_per_1000ft_ohms: 0.628, ampacity_outside_engine_105c: 80, ampacity_inside_engine_105c: 68 },
  { awg: "6",  circular_mils: 26240, resistance_per_1000ft_ohms: 0.395, ampacity_outside_engine_105c: 120, ampacity_inside_engine_105c: 102 },
  { awg: "4",  circular_mils: 41740, resistance_per_1000ft_ohms: 0.249, ampacity_outside_engine_105c: 160, ampacity_inside_engine_105c: 136 },
  { awg: "2",  circular_mils: 66360, resistance_per_1000ft_ohms: 0.156, ampacity_outside_engine_105c: 210, ampacity_inside_engine_105c: 178 },
  { awg: "1/0", circular_mils: 105600, resistance_per_1000ft_ohms: 0.098, ampacity_outside_engine_105c: 285, ampacity_inside_engine_105c: 242 },
  { awg: "2/0", circular_mils: 133100, resistance_per_1000ft_ohms: 0.078, ampacity_outside_engine_105c: 330, ampacity_inside_engine_105c: 280 },
  { awg: "4/0", circular_mils: 211600, resistance_per_1000ft_ohms: 0.049, ampacity_outside_engine_105c: 445, ampacity_inside_engine_105c: 378 },
];

export function calculateDCWireAndFuse(params: WireCalculationParams): WireCalculationResult {
  const round_trip_feet = params.one_way_distance_feet * 2;
  const allowable_v_drop = params.system_voltage * (params.allowable_drop_percent / 100);
  const K = 10.75; // Copper constant

  // 1. Calculate Required Circular Mils
  const required_circular_mils = (K * params.amperage * round_trip_feet) / allowable_v_drop;

  // 2. Filter AWG Table based on BOTH Circular Mils AND Ampacity Safety Limits
  const matched_spec = AWG_TABLE.find(spec => {
    const meets_drop = spec.circular_mils >= required_circular_mils;
    const max_ampacity = params.is_engine_compartment 
      ? spec.ampacity_inside_engine_105c 
      : spec.ampacity_outside_engine_105c;
    const meets_ampacity = max_ampacity >= params.amperage;
    return meets_drop && meets_ampacity;
  });

  if (!matched_spec) {
    throw new Error(`Exceeds 4/0 AWG limits. Consider upgrading system voltage to 24V or 48V.`);
  }

  // 3. Exact Calculations
  const loop_resistance = (matched_spec.resistance_per_1000ft_ohms / 1000) * round_trip_feet;
  const actual_v_drop = params.amperage * loop_resistance;
  const actual_percent_drop = (actual_v_drop / params.system_voltage) * 100;

  // 4. Overcurrent Protection Sizing (ABYC: Fuse within 7" of battery positive, max 150% of wire rating)
  const wire_ampacity = params.is_engine_compartment 
    ? matched_spec.ampacity_inside_engine_105c 
    : matched_spec.ampacity_outside_engine_105c;
  
  // Standard recommended fuse is 125% of load, not exceeding wire ampacity
  let recommended_fuse = Math.round(params.amperage * 1.25);
  if (recommended_fuse > wire_ampacity) {
    recommended_fuse = wire_ampacity;
  }

  // Select appropriate fuse form factor based on amperage
  let fuse_type = "ATC/ATO Blade";
  if (recommended_fuse > 30 && recommended_fuse <= 100) fuse_type = "MIDI / AMI Fuse";
  if (recommended_fuse > 100 && recommended_fuse <= 300) fuse_type = "MRBF (Marine Rated Battery Fuse) or MEGA";
  if (recommended_fuse > 300) fuse_type = "Class T Fuse (Essential for LiFePO4 high AIC ratings)";

  return {
    recommended_awg: matched_spec.awg,
    exact_voltage_drop_volts: parseFloat(actual_v_drop.toFixed(2)),
    exact_voltage_drop_percent: parseFloat(actual_percent_drop.toFixed(2)),
    recommended_fuse_amps: recommended_fuse,
    fuse_type,
    notes: [
      `Calculation based on ${round_trip_feet}ft total circuit path (positive + negative return).`,
      `Wire must be stranded, tinned copper rated for 105°C minimum (UL 1426 / SAE J1127).`,
      `Overcurrent protection must be installed within 7 inches of the power source terminal.`
    ]
  };
}

6. MCP Server Implementation (Cloudflare Worker)
This runs natively inside Cloudflare Workers, exposing tools over standard HTTP JSON-RPC 2.0.
Worker MCP Engine (src/index.ts)
import { calculateDCWireAndFuse, WireCalculationParams } from "./mcp/tools/wire_calc";

export interface Env {
  DB: D1Database;
  VECTORIZE: VectorizeIndex;
  AI: any;
  ASSETS_BUCKET: R2Bucket;
  CDN_BASE_URL: string;
}

export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    const url = new URL(request.url);

    // MCP JSON-RPC Endpoint
    if (request.method === "POST" && url.pathname === "/mcp") {
      const authHeader = request.headers.get("Authorization");
      if (!authHeader?.startsWith("Bearer ")) {
        return new Response(JSON.stringify({ error: "Missing or invalid API key" }), { status: 401 });
      }
      const apiKey = authHeader.replace("Bearer ", "");

      // 1. Authenticate & Meter Account
      const account = await env.DB.prepare(
        "SELECT id, balance_microcents FROM accounts WHERE api_key_hash = ? AND is_active = 1"
      ).bind(apiKey).first<{ id: string; balance_microcents: number }>();

      if (!account || account.balance_microcents <= 0) {
        return new Response(JSON.stringify({ error: "Insufficient account balance or inactive key" }), { status: 402 });
      }

      const body: any = await request.json();
      const response = await handleMcpRequest(body, env, account.id);
      return new Response(JSON.stringify(response), {
        headers: { "Content-Type": "application/json" }
      });
    }

    return new Response("Campervan MCP Server Online", { status: 200 });
  }
};

async function handleMcpRequest(body: any, env: Env, accountId: string): Promise<any> {
  const { id, method, params } = body;

  // MCP Protocol Discovery
  if (method === "tools/list") {
    return {
      jsonrpc: "2.0",
      id,
      result: {
        tools: [
          {
            name: "lookup_vehicle_electrical_specs",
            description: "Queries vetted OEM Body and Equipment Mounting Manuals (Ford Transit, Sprinter, ProMaster) and component technical documentation.",
            inputSchema: {
              type: "object",
              properties: {
                query: { type: "string", description: "Search query or question." },
                chassis: { type: "string", enum: ["ford_transit", "mercedes_sprinter", "ram_promaster", "universal"] },
                subsystem: { type: "string", enum: ["12v_dc", "48v_dc", "120v_ac", "chassis_interface", "plumbing"] }
              },
              required: ["query", "chassis"]
            }
          },
          {
            name: "calculate_dc_wire_and_fuse",
            description: "Performs deterministic ABYC E-11 compliant DC cable gauge (AWG), voltage drop, and overcurrent fuse sizing.",
            inputSchema: {
              type: "object",
              properties: {
                system_voltage: { type: "number", enum: [12, 24, 48] },
                amperage: { type: "number" },
                one_way_distance_feet: { type: "number" },
                allowable_drop_percent: { type: "number", enum: [3, 10] },
                is_engine_compartment: { type: "boolean" }
              },
              required: ["system_voltage", "amperage", "one_way_distance_feet", "allowable_drop_percent", "is_engine_compartment"]
            }
          }
        ]
      }
    };
  }

  // MCP Tool Execution
  if (method === "tools/call") {
    const { name, arguments: args } = params;
    const startTime = Date.now();
    let toolResult: any;
    let toolCostMicrocents = 2000; // $0.002000 per search call

    if (name === "calculate_dc_wire_and_fuse") {
      toolCostMicrocents = 500; // $0.000500 per deterministic math call
      toolResult = calculateDCWireAndFuse(args as WireCalculationParams);
    } else if (name === "lookup_vehicle_electrical_specs") {
      toolResult = await executeHybridSearch(args, env);
    } else {
      return { jsonrpc: "2.0", id, error: { code: -32601, message: "Tool not found" } };
    }

    // Record usage and deduct balance (Atomic batch)
    await env.DB.batch([
      env.DB.prepare(
        "UPDATE accounts SET balance_microcents = balance_microcents - ? WHERE id = ?"
      ).bind(toolCostMicrocents, accountId),
      env.DB.prepare(
        "INSERT INTO usage_records (account_id, tool_name, cost_microcents, execution_time_ms) VALUES (?, ?, ?, ?)"
      ).bind(accountId, name, toolCostMicrocents, Date.now() - startTime)
    ]);

    return {
      jsonrpc: "2.0",
      id,
      result: {
        content: [
          {
            type: "text",
            text: typeof toolResult === "string" ? toolResult : JSON.stringify(toolResult, null, 2)
          }
        ]
      }
    };
  }

  return { jsonrpc: "2.0", id, error: { code: -32600, message: "Invalid Request" } };
}

async function executeHybridSearch(args: any, env: Env): Promise<string> {
  // 1. Generate Query Vector Embedding via Workers AI
  const embeddingResponse = await env.AI.run("@cf/baai/bge-base-en-v1.5", {
    text: [args.query]
  });
  const queryVector = embeddingResponse.data[0];

  // 2. Query Vectorize for top 3 Nearest Neighbors
  const vectorMatches = await env.VECTORIZE.query(queryVector, {
    topK: 3,
    returnMetadata: "all"
  });

  if (!vectorMatches.matches || vectorMatches.matches.length === 0) {
    return "No authoritative specifications matched your query.";
  }

  const chunkIds = vectorMatches.matches.map((m: any) => m.id);

  // 3. Hydrate Full Text & Metadata from Cloudflare D1
  const placeholders = chunkIds.map(() => "?").join(",");
  const rows = await env.DB.prepare(`
    SELECT c.id, c.page_number, c.subsystem, c.chunk_text, d.title, d.manufacturer, s.r2_key, s.caption
    FROM document_chunks c
    JOIN documents d ON c.document_id = d.id
    LEFT JOIN schematic_images s ON c.schematic_image_id = s.id
    WHERE c.id IN (${placeholders})
  `).bind(...chunkIds).all();

  // 4. Assemble Grounded Context Block
  let output = `### Authoritative OEM & Subsystem Specifications\n\n`;
  for (const row of rows.results as any[]) {
    output += `**Source:** ${row.manufacturer} - ${row.title} (Page ${row.page_number})\n`;
    output += `**Subsystem:** ${row.subsystem}\n`;
    output += `**Specification Content:**\n${row.chunk_text}\n`;
    if (row.r2_key) {
      output += `**Schematic Diagram Link:** ${env.CDN_BASE_URL}/${row.r2_key} (${row.caption})\n`;
    }
    output += `\n---\n`;
  }

  return output;
}

