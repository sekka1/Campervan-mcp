{
  "name": "campervan-mcp-server",
  "version": "1.0.0",
  "description": "Campervan Technical & Electrical MCP Server built on Cloudflare Workers",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit scripts",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "ingest:manuals": "tsx scripts/ingest-manuals.ts",
    "sync:r2": "tsx scripts/sync-r2-manuals.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.0",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "tsx": "4.23.1",
    "typescript": "^5.5.0",
    "unpdf": "1.8.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.115.0"
  },
  "engines": {
    "node": ">=22"
  }
}
