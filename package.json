{
  "name": "campervan-mcp-server",
  "version": "1.0.0",
  "description": "Campervan Technical & Electrical MCP Server built on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "deploy": "cf deploy",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit scripts",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "ingest:manuals": "tsx scripts/ingest-manuals.ts",
    "sync:r2": "tsx scripts/sync-r2-manuals.ts",
    "e2e:vectorize": "tsx scripts/e2e-vectorize-smoke-test.ts",
    "test:live": "RUN_LIVE_TESTS=true vitest run tests/live/smoke.test.ts",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.0",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@napi-rs/canvas": "^1.0.13",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "cf": "1.0.0-beta.18",
    "eslint": "^9.0.0",
    "tsx": "4.23.1",
    "typescript": "^5.5.0",
    "unpdf": "1.8.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=22"
  }
}